# .env.example
# Aspire Travels Environment Configuration

# Cloudflare Worker URL for Static Site Email Dispatch (Render Static -> Cloudflare Worker -> Resend)
# Example: https://aspire-travels-email-worker.your-subdomain.workers.dev
VITE_EMAIL_WORKER_URL=

# Resend API Key (Stored in Cloudflare Worker secret: RESEND_API_KEY)
RESEND_API_KEY=

# Support Email recipient (defaults to support@aspiretravels.in)
SUPPORT_EMAIL=support@aspiretravels.in

# From Email address for outgoing notifications (optional, defaults to support@aspiretravels.in)
FROM_EMAIL=support@aspiretravels.in

# Gemini API Key (if server-side AI integrations are added)
GEMINI_API_KEY=

